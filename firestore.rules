rules_version = '2';

// A pet and everything under it belongs to its `members`. Nobody outside the
// list can read or write it. Joining needs a live invite code for that pet.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMemberOf(petId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/pets/$(petId)).data.members;
    }

    match /pets/{petId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      function onlyChanges(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      // a member edits the pet's data; membership and owner stay as they are,
      // and only the owner may flag the pet as deleted
      function editing() {
        return request.resource.data.members == resource.data.members
          && request.resource.data.ownerUid == resource.data.ownerUid
          && (request.resource.data.deleted == resource.data.deleted
              || resource.data.ownerUid == request.auth.uid);
      }

      function leaving() {
        return onlyChanges(['members'])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && !(request.auth.uid in request.resource.data.members);
      }

      // a newcomer adds only themself, and proves it with an unexpired invite for this pet
      function joining() {
        let invite = get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode));
        return signedIn()
          && onlyChanges(['members', 'joinCode'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && invite.data.petId == petId
          && invite.data.expiresAt > request.time;
      }

      allow read: if isMember();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow update: if (isMember() && (editing() || leaving())) || joining();

      // pets are never removed: the owner sets deleted = true so other phones hear about it
      allow delete: if false;
    }

    match /pets/{petId}/{collection}/{docId} {
      allow read, write: if collection in ['records', 'weights', 'appointments', 'contacts']
        && isMemberOf(petId);
    }

    match /invites/{code} {
      // codes are looked up by exact id; listing them is not possible
      allow get: if signedIn();
      allow list, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && isMemberOf(request.resource.data.petId)
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
    }
  }
}
